# =============================================================================
# Venüs Termal — EMR Hotspot SAHA KURULUM FORMU
# =============================================================================
# Nasıl kullanılır:
#   1) Bu dosyayı kopyala:  copy site.env.example site.env   (Windows)
#                           cp site.env.example site.env     (Linux)
#   2) Kablo / IP verirken AŞAĞIDAKİ BOŞ ALANLARI doldur.
#   3) PORT alanlarını SEN yaz (boş bırakılmış).
#   4) site.env asla git'e commit etme.
#
# Referans (önceki canlı lab — zorunlu değil, sadece hatırlatma):
#   Web 3040 | API 3041 | Server 172.16.25.200 | MikroTik 172.16.25.252
#   Hotspot GW 172.16.25.2 | SSID emr-cisco | tenant venus-termal
# =============================================================================

# --- Kimlik / tenant ---------------------------------------------------------
TENANT_ID=venus-termal
SSID=
WA_TEMPLATE=venus_wifi_portal_v2
PORTAL_LOGIN_BUILD=android-dual-pending-otp-radius-v53

# --- PORTLAR (SEN YAZ) -------------------------------------------------------
# Web captive portal dinleme portu
WEB_PORT=
# API / RADIUS yardımcı servis portu
API_PORT=

# --- Kablo / IP planı (kurarken doldur) --------------------------------------
# EMR sunucu (API+Web host) — örnek: 172.16.25.200
EMR_SERVER_IP=
EMR_SERVER_IFACE=
EMR_SERVER_NETMASK=

# MikroTik yönetim IP — örnek: 172.16.25.252
MIKROTIK_IP=
MIKROTIK_USER=
# MIKROTIK_PASSWORD=   → secrets / ayrı güvenli dosya; buraya yazma

# Hotspot gateway (wLAN tarafı) — örnek: 172.16.25.2
HOTSPOT_GATEWAY_IP=
HOTSPOT_DHCP_POOL_START=
HOTSPOT_DHCP_POOL_END=
HOTSPOT_DNS=

# WAN / uplink (otele göre)
WAN_IP=
WAN_GATEWAY=
WAN_DNS=

# --- RADIUS ------------------------------------------------------------------
RADIUS_HOST=
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SECRET=
# phone / emr-android-pending → emr-android-temp
RADIUS_PENDING_PROFILE=emr-android-temp
RADIUS_SESSION_TIMEOUT_SEC=300
RADIUS_ADD_MAC_COOKIE=no

# --- PENDING_OTP (v53 dual-path) ---------------------------------------------
# Numara + WA gönder → hemen ~5 dk yetkili internet
PENDING_OTP_SECONDS=300
PENDING_OTP_GRACE_SECONDS=5
PENDING_OTP_REVOKE_KICK=true
# Doğrulama yok → süre bitince sert kesim (kick:true)
# WA link aynı numara + kimlik → 24s full grant
FULL_GRANT_HOURS=24

# --- Servis URL (port doldurulunca otomatik veya elle) -----------------------
# Örnek: http://EMR_SERVER_IP:WEB_PORT
PUBLIC_WEB_BASE_URL=
# Örnek: http://EMR_SERVER_IP:API_PORT
PUBLIC_API_BASE_URL=

# --- Son kontrol bayrakları (kurulum bitince true yap) -----------------------
CHECK_RADIUS_UDP_1812=
CHECK_ANDROID_PENDING_OTP_TIMED=
CHECK_REVOKE_KICK_TRUE=
CHECK_NO_MAC_COOKIE_BYPASS=
CHECK_IPHONE_WHATSAPP_LINK_JSON=
CHECK_LOGIN_HTML_V53=
